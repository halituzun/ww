{
  "name": "@ww/executor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tools/*": "./tools/*",
    "./templates/*": "./templates/*"
  },
  "files": [
    "dist",
    "runtime",
    "tools",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:live": "WW_DOCKER_LIVE=1 WW_EXECUTOR_IMAGE=ww-executor-runtime:local vitest run src/sandbox.live.test.ts src/durable-audit.live.test.ts",
    "runtime:build": "docker build -t ww-executor-runtime:local runtime",
    "lint": "eslint src && node --check runtime/run-step.mjs && node --check runtime/snapshot.mjs"
  },
  "dependencies": {
    "@ww/db": "workspace:*",
    "@ww/shared": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
