{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "delete_file",
  "description": "Move a declared workspace file to .ww-trash. Files are never truly deleted.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$" }
  },
  "required": ["path"]
}
