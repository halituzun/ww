{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "move_file",
  "description": "Move a declared workspace file to another declared path.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "from": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$" },
    "to": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$" }
  },
  "required": ["from", "to"]
}
