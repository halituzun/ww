{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "create_subtask",
  "description": "Delegate a bounded piece of work as a child task (docs/03 delegation).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "description": "Target files the subtask may write. A subtask without targets can produce nothing."
    },
    "criteria": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "budget": { "type": "integer", "minimum": 0, "maximum": 10000000 }
  },
  "required": ["title", "description", "files"]
}
