# ww — yerel geliştirme ortam değişkenleri örneği.
#
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` gitignore
# kapsamındadır; API anahtarları, token ve yerel volume yolları asla
# commit'lenmez. Adım adım kurulum: docs/KURULUM.md
#
# NEDEN VAR: .gitignore `!.env.example` istisnasını taşıyordu ama kökte
# şablon yoktu; yeni bir makinede hangi değişkenlerin gerektiği ancak
# docs/KURULUM.md okunarak çıkarılabiliyordu.

# --- Oturum ---
# Panelin yazma uçlarını kullanabilmesi için VITE_SESSION_TOKEN ile AYNI
# olmalıdır (apps/panel/.env). Farklıysa vite başlangıçta hata verir.
# Üretmek için: openssl rand -hex 32
WW_LOCAL_SESSION_TOKEN=

# --- Anahtar deposu ---
# Sağlayıcı API anahtarlarının şifrelendiği 32 baytlık hex anahtar.
# Container kipinde ZORUNLU; verilmezse keystore macOS Keychain'e düşer.
# DİKKAT: .env'deki WW_MASTER_KEY ile Keychain'deki 'ww-master' FARKLI
# anahtarlardır. Tek kaynağa karar verin; yoksa mevcut keys.json çözülemez.
WW_MASTER_KEY=
# Keystore dosyasının yolu. Boş bırakılırsa workspace kökünden çözülür.
WW_KEYSTORE_FILE=

# --- Orkestrasyon motoru ---
# 1 yapılırsa görev pompası ve agent runtime açılır. Motor YALNIZCA
# status=running projeleri alır (PATCH /projects/:id/status ile çalıştırın).
WW_PHASE8_RUNTIME_ENABLED=0
# Birden çok çalışan proje varken motor sessizce birini seçmez; hangi
# projede koşacağı burada açıkça verilir.
WW_RUNTIME_PROJECT_ID=

# --- Servisler ---
# Portlar bilinçli olarak standart dışıdır (8123/6379 değil): makinede başka
# projelerin container'ları var.
WW_CH_URL=http://localhost:8124
WW_CH_USER=default
WW_CH_PASS=
WW_CH_DB=ww
WW_REDIS_URL=redis://localhost:6380

# --- Sunucu ---
WW_PORT=4000
# Panelin origin'i; virgülle birden çok verilebilir.
WW_PANEL_ORIGINS=http://localhost:5173

# --- İsteğe bağlı ---
# Güvenlik frenlerini (token/maliyet/duvar-saati/kaçak döngü) KAPATIR.
# Varsayılan açıktır; kapatmak bilinçli bir karar olmalıdır.
# WW_DISABLE_BRAKES=1
# Görev pompasının eşzamanlılığı (varsayılan 2, üst sınır 8).
# WW_PUMP_CONCURRENCY=2
# Entegrasyon testlerinin sessizce atlanmasını HATAYA çevirir.
# WW_REQUIRE_INTEGRATION=1
