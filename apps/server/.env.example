# VITE_API_PROXY_TARGET ile aynı portta olmalıdır.
WW_PORT=4000

# REST mutating uçları için lokal bearer session (geliştirmede test fixture kullanılır).
WW_LOCAL_SESSION_TOKEN=change-me

# Production örneği: panel https://panel.example.com, API https://api.example.com.
# Aşağıdaki değeri açın; panel build'inde de
# VITE_API_BASE_URL=https://api.example.com ayarlayın.
# WW_PANEL_ORIGINS=https://panel.example.com

# CI veya Docker entegrasyon kapısında live sağlık assertion'ını zorunlu kılar.
# WW_REQUIRE_INTEGRATION=1
