# Lokal geliştirme: apps/server WW_PORT değişirse bu hedefin portunu da değiştirin.
VITE_API_PROXY_TARGET=http://localhost:4000

# Yerel oturum tokenı. Server'ın WW_LOCAL_SESSION_TOKEN değeriyle AYNI olmalıdır;
# yoksa yazma uçları 401 döner. Gerçek değeri .env.local içine koyun (gitignore'da).
VITE_SESSION_TOKEN=

# Production örneği: panel https://panel.example.com, API https://api.example.com.
# Build sırasında aşağıdaki değeri açın; server'da da
# WW_PANEL_ORIGINS=https://panel.example.com ayarlayın.
# VITE_API_BASE_URL=https://api.example.com
